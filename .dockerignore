# Keep Docker build context lean. Anything not needed inside an image
# should be excluded.

# Python build artifacts
__pycache__
*.pyc
*.pyo
*.egg-info
.venv
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
htmlcov

# Frontend build artifacts (apps/studio/Dockerfile handles its own context)
node_modules
**/node_modules
.next
**/.next

# Repo metadata
.git
.github
.idea
.vscode

# Local secrets / state — never bake into images
.env
.env.*
!.env.example

# Infra is built from cluster, not from inside images.
# Exception: the root Dockerfile COPYs infra/postgres/migrations, which
# agentforge-migrate reads at runtime — so exclude the subtrees, not all of
# infra. (Excluding `infra` outright makes that COPY fail.)
infra/helm
infra/terraform
pitch

# Not needed inside the Python image.
tests
scripts
docs
docker-compose.yml

# Misc
.DS_Store
*.md
!README.md
